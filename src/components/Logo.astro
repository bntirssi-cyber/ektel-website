---
/**
 * Echte Marke: rote Wortmarke "EKTEL", wie auf dem Ladenschild im Bahnhof Altona
 * (Kunden-Foto, 2026-09-16). Farbe/Schnitt sind vom Foto abgeleitet – siehe
 * docs/logo-brief.md für den Vorbehalt (kein Vektor-Original vorhanden).
 */
interface Props { class?: string; title?: string }
const { class: cls = 'h-6 w-auto', title = 'EKTEL' } = Astro.props;
---
<svg class={cls} viewBox="0 0 108 26" role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <text
    x="0"
    y="20.5"
    font-family="Funnel Display Variable, Arial, sans-serif"
    font-weight="800"
    font-size="23"
    letter-spacing="0.5"
    fill="var(--brand-red, #E2001A)"
  >EKTEL</text>
</svg>
