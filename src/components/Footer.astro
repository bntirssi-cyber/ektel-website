---
import { shop } from '../data/shop';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---
<footer class="mt-24 border-t border-sky-200 bg-sky-100/70 px-4 pt-10 text-sm text-ink-700 pb-[max(2.5rem,env(safe-area-inset-bottom))]">
  <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-bold text-ink-900">{shop.name}</p>
      <p class="mt-1">{shop.street}<br />{shop.zip} {shop.city}-{shop.district}<br />{shop.locationHint}</p>
      <a href={`tel:${shop.phone}`} class="mt-2 inline-block font-semibold text-ink-900 hover:text-accent-700">{shop.phoneDisplay}</a>
    </div>
    <div>
      <p class="font-semibold text-ink-900">Öffnungszeiten</p>
      <p class="mt-1">Mo–Sa {shop.hours.mon.open}–{shop.hours.mon.close} Uhr<br />So {shop.hours.sun.open}–{shop.hours.sun.close} Uhr</p>
      <p class="mt-1 text-ink-500">{shop.hoursNote}</p>
    </div>
    <nav aria-label="Rechtliches" class="flex flex-col gap-2">
      <a href={`${base}impressum`} class="inline-block py-2 hover:text-accent-700">Impressum</a>
      <a href={`${base}datenschutz`} class="inline-block py-2 hover:text-accent-700">Datenschutz</a>
    </nav>
  </div>
  <p class="mx-auto mt-8 max-w-6xl text-ink-500">© {year} {shop.name} · Inh. {shop.owner}</p>
</footer>
