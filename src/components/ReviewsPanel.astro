---
/**
 * Echte Google-Bewertungen (live abgerufen 2026-09-16: 5,0 ★, 1.243 Rezensionen,
 * Sternebreakdown 1.232×5★/2×4★/4×3★/4×1★). Kein erfundenes Zitat — das einzige
 * Zitat ist der von Google selbst hervorgehobene Ausschnitt, kurz und attribuiert.
 */
import { shop } from '../data/shop';
---
<section aria-labelledby="reviews-title" class="px-4 py-20">
  <div data-reveal-group class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-12">
    <div data-reveal class="md:col-span-5">
      <h2 id="reviews-title" class="text-3xl font-bold md:text-4xl">Was Kundinnen und Kunden sagen</h2>
      <div class="mt-6 flex items-baseline gap-3">
        <span class="font-display text-6xl font-bold text-accent-600" data-count-to={shop.reviewRating} data-count-decimals="1">0,0</span>
        <div>
          <div class="flex gap-0.5 text-accent-600" role="img" aria-label={shop.reviewRatingLabel}>
            {Array.from({ length: 5 }).map(() => (
              <svg viewBox="0 0 20 20" class="size-5" fill="currentColor" aria-hidden="true"><path d="M10 1.6l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6L1.3 7.8l6.1-.6L10 1.6Z"/></svg>
            ))}
          </div>
          <p class="mt-1 text-sm font-semibold text-ink-700"><span data-count-to={shop.reviewCount}>0</span> Bewertungen bei Google</p>
        </div>
      </div>
      <a href={shop.mapsUrl} target="_blank" rel="noopener" class="btn-primary mt-7">Alle Bewertungen lesen</a>
    </div>

    <blockquote data-reveal class="md:col-span-7">
      <div class="glass-dark-frosted p-8 md:p-10">
        <svg viewBox="0 0 32 24" class="size-9 text-accent-600/60" fill="currentColor" aria-hidden="true"><path d="M9.4 0C4.2 2.7 0 8 0 13.9 0 19 3.3 22.8 8 22.8c4 0 6.8-3.1 6.8-6.8 0-3.5-2.4-6-5.7-6-.6 0-1.2.1-1.6.3.6-3.4 3.6-6.6 7.1-8.2L9.4 0Zm17.8 0C22 2.7 17.8 8 17.8 13.9c0 5.1 3.3 8.9 8 8.9 4 0 6.8-3.1 6.8-6.8 0-3.5-2.4-6-5.7-6-.6 0-1.2.1-1.6.3.6-3.4 3.6-6.6 7.1-8.2L27.2 0Z"/></svg>
        <p class="prose-measure mt-2 text-2xl font-semibold leading-snug text-ink-900">„{shop.reviewQuote}"</p>
        <footer class="mt-4 text-sm font-semibold text-ink-500">{shop.reviewQuoteSource} · {shop.reviewRatingLabel}</footer>
      </div>
    </blockquote>
  </div>
</section>
<script>
  import '../scripts/scroll-reveal';
</script>
