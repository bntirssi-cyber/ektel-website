---
import Logo from './Logo.astro';
import { shop } from '../data/shop';

const items = [
  ['/', 'Start'],
  ['/leistungen', 'Leistungen'],
  ['/kontakt', 'Kontakt'],
] as const;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header data-header class="sticky top-0 z-40 px-4 pt-3">
  <div class="glass-frosted mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-2 md:px-5">
    <a href="/" class="flex items-center text-ink-900" aria-label="EKTEL – zur Startseite"><Logo /></a>

    <nav aria-label="Hauptnavigation" class="hidden items-center gap-7 md:flex">
      {items.map(([href, label]) => (
        <a
          href={href}
          aria-current={path === href ? 'page' : undefined}
          class="py-2 font-semibold text-ink-700 hover:text-accent-700 aria-[current=page]:text-accent-700 aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
        >{label}</a>
      ))}
      <a href={`tel:${shop.phone}`} class="btn-primary">Jetzt anrufen</a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <a href={`tel:${shop.phone}`} class="btn-primary px-4" aria-label="Jetzt anrufen">Anrufen</a>
      <details data-menu class="relative">
        <summary class="btn-ghost cursor-pointer list-none px-4 [&::-webkit-details-marker]:hidden">Menü</summary>
      <div class="glass-frosted absolute right-0 mt-2 flex w-60 flex-col gap-1 p-2">
        {items.map(([href, label]) => (
          <a href={href} aria-current={path === href ? 'page' : undefined} class="rounded-xl px-3 py-3 font-semibold text-ink-900 hover:bg-sky-100 aria-[current=page]:text-accent-700">{label}</a>
        ))}
        <a href={`tel:${shop.phone}`} class="btn-primary mt-1">Jetzt anrufen</a>
      </div>
      </details>
    </div>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const setVar = () => document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    setVar();
    new ResizeObserver(setVar).observe(header);
  }
</script>
<script>
  // Mobile-Menü: schließt bei Klick außerhalb und mit Escape.
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
