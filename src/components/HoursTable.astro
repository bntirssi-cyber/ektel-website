---
import { shop } from '../data/shop';
import { DAY_NAMES, type DayKey } from '../lib/opening-hours';
const days = Object.keys(shop.hours) as DayKey[];
---
<table class="w-full text-left">
  <caption class="sr-only">Öffnungszeiten</caption>
  <tbody>
    {days.map((d) => {
      const h = shop.hours[d];
      return (
        <tr class="border-t border-sky-200">
          <th scope="row" class="py-2 pr-4 font-semibold">{DAY_NAMES[d]}</th>
          <td class="py-2 tabular-nums">{h ? `${h.open}–${h.close} Uhr` : 'geschlossen'}</td>
        </tr>
      );
    })}
  </tbody>
</table>
<p class="mt-3 text-sm text-ink-500">{shop.hoursNote}</p>
