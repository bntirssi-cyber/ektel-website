---
/**
 * Hero: bildschirmfüllende, scroll-gescrubbte Explosionsansicht des Smartphones.
 * Text liegt direkt auf dem Video (kein Glas-Panel hier – die Glas-Optik bleibt allen
 * anderen Oberflächen der Site vorbehalten); ein heller Scrim sorgt für Kontrast auf
 * dem hellen Studio-Hintergrund des Clips.
 */
import OpenBadge from './OpenBadge.astro';
import { shop } from '../data/shop';

const FRAMES = 80;
---
<section
  data-scroll-phone
  data-frames={FRAMES}
  class="scroll-phone relative"
  style="margin-top: calc(-1 * var(--header-h, 4.5rem));"
  aria-labelledby="hero-title"
>
  <div class="screen sticky top-0 h-dvh overflow-hidden">
    <canvas data-canvas class="absolute inset-0 block h-full w-full" aria-label="Smartphone in Einzelteilen: Display, Akku und Platine heben sich beim Scrollen voneinander ab" role="img"></canvas>
    <img data-poster src="/phone/poster.webp" width="1280" height="720" alt="" class="absolute inset-0 h-full w-full object-cover" decoding="async" fetchpriority="high" />
    <div class="scrim absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto flex h-full max-w-6xl items-end px-4 pt-24 pb-[max(2rem,env(safe-area-inset-bottom))] text-ink-900 md:items-center md:pb-0">
      <div class="w-full md:max-w-xl">
        <OpenBadge variant="plain" class="mb-4" />
        <h1 id="hero-title" class="text-3xl font-bold md:text-5xl">Handy kaputt? Wir helfen – alles an einem Ort.</h1>
        <p class="catchline prose-measure mt-3 text-lg text-ink-700">
          Reparatur, Verkauf und Ankauf – ehrlich beraten, mitten im Bahnhof Altona.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={`tel:${shop.phone}`} class="btn-primary">Jetzt anrufen</a>
          <a href={shop.mapsUrl} class="btn-ghost" rel="noopener" target="_blank">Route planen</a>
        </div>
      </div>
    </div>
  </div>
</section>
<noscript>
  <style>
    .scroll-phone { min-height: 0 !important; }
    .scroll-phone .screen { position: static !important; height: auto !important; min-height: 100dvh; }
  </style>
</noscript>
<script>
  import '../scripts/scroll-phone';
</script>
<style>
  .scroll-phone { min-height: 300vh; }
  .screen { background: linear-gradient(180deg, #f4f5f6 0%, #ffffff 100%); }
  .screen[data-ready] img[data-poster] { opacity: 0; }
  /* Heller Verlauf: hält dunklen Text lesbar, falls ein Schatten oder Bauteil unter ihn wandert. */
  .scrim {
    background:
      linear-gradient(180deg, transparent 0%, transparent 55%, rgba(255, 255, 255, 0.78) 100%),
      linear-gradient(100deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.45) 38%, transparent 62%);
  }
  @media (max-height: 640px) {
    .catchline { display: none; }
    .scroll-phone h1 { font-size: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-phone { min-height: 0; }
    .screen { position: static; height: auto; min-height: 100dvh; }
  }
</style>
