---
/**
 * Hero: bildschirmfüllende, scroll-gescrubbte Explosionsansicht des Smartphones.
 * Nur die Headline liegt direkt auf dem Video, links am Bildschirmrand, in sehr großer
 * Schrift (Kundenwunsch 2026-09-16) – kein Glas-Panel, kein Fülltext, nur ein heller
 * Scrim für Kontrast. Rechts bleibt Platz für die Scroll-Animation.
 */
import { shop } from '../data/shop';

const FRAMES = 80;
const base = import.meta.env.BASE_URL;
---
<section
  data-scroll-phone
  data-frames={FRAMES}
  class="scroll-phone relative"
  style="margin-top: calc(-1 * var(--header-h, 4.5rem));"
  aria-labelledby="hero-title"
>
  <div class="screen sticky top-0 h-dvh overflow-hidden">
    <canvas data-canvas class="absolute inset-0 block h-full w-full" aria-label="Smartphone in Einzelteilen: Display, Akku und Platine heben sich beim Scrollen voneinander ab" role="img"></canvas>
    <img data-poster src={`${base}phone/poster.webp`} width="1920" height="1080" alt="" class="absolute inset-0 h-full w-full object-cover" decoding="async" fetchpriority="high" />
    <div class="scrim absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-10 flex h-full items-end px-5 pb-[max(2.5rem,env(safe-area-inset-bottom))] pt-24 text-ink-900 sm:px-8 md:items-center lg:px-14">
      <div>
        <h1 id="hero-title" class="max-w-[18ch] text-[clamp(2.25rem,6vw,4.75rem)] font-bold leading-[0.98]">Handy kaputt? Wir helfen – alles an einem Ort.</h1>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`tel:${shop.phone}`} class="btn-primary">Jetzt anrufen</a>
          <a href={shop.mapsUrl} class="btn-ghost" rel="noopener" target="_blank">Route planen</a>
        </div>
      </div>
    </div>
  </div>
</section>
<noscript>
  <style>
    .scroll-phone { min-height: 0 !important; }
    .scroll-phone .screen { position: static !important; height: auto !important; min-height: 100dvh; }
  </style>
</noscript>
<script>
  import '../scripts/scroll-phone';
</script>
<style>
  .scroll-phone { min-height: 300vh; }
  .screen { background: linear-gradient(180deg, #f4f5f6 0%, #ffffff 100%); }
  .screen[data-ready] img[data-poster] { opacity: 0; }
  /* Heller Verlauf: hält dunklen Text lesbar, falls ein Schatten oder Bauteil unter ihn wandert. */
  .scrim {
    background:
      linear-gradient(180deg, transparent 0%, transparent 55%, rgba(255, 255, 255, 0.7) 100%),
      linear-gradient(100deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.5) 34%, transparent 58%);
  }
  @media (max-height: 640px) {
    .scroll-phone h1 { font-size: clamp(1.75rem, 6vw, 3rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-phone { min-height: 0; }
    .screen { position: static; height: auto; min-height: 100dvh; }
  }
</style>
