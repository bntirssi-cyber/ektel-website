---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPanel from '../components/GlassPanel.astro';
import { shop } from '../data/shop';
import workbench from '../assets/img/repair-workbench.jpg';
import display from '../assets/img/repair-display.jpg';
import microscope from '../assets/img/repair-microscope.jpg';
import verkauf from '../assets/img/service-verkauf.jpg';
import ankauf from '../assets/img/service-ankauf.jpg';
import sim from '../assets/img/service-sim.jpg';

const photos = { accessories: verkauf, 'trade-in': ankauf, sim } as const;
---
<BaseLayout theme="dark" title="Leistungen – Reparatur, Verkauf, Ankauf, SIM | EKTEL Altona" description="Smartphone-Reparatur (Display, Akku, Ladebuchse), Verkauf, Ankauf und SIM-Karten bei EKTEL im Bahnhof Hamburg-Altona.">
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-16">
    <h1 class="text-4xl font-bold md:text-5xl">Leistungen</h1>
    <p class="prose-measure mt-4 text-lg text-ink-700">Alles rund ums Smartphone an einem Ort – ohne Termin, sieben Tage die Woche.</p>
    <nav aria-label="Leistungen" class="mt-6 flex flex-wrap gap-2">
      {shop.services.map((s) => (
        <a href={`#${s.slug}`} class="chip-dark-glass min-h-11">{s.title}</a>
      ))}
    </nav>
  </section>

  {shop.services.map((s, i) => (
    <section id={s.slug} aria-labelledby={`${s.slug}-title`} class="mx-auto max-w-6xl scroll-mt-28 px-4 py-6 md:py-8">
      <GlassPanel as="div" variant="frosted" theme="dark" class={`grid items-stretch overflow-hidden md:grid-cols-2 ${i % 2 ? 'md:[&>figure]:order-2' : ''}`}>
        <figure class="overflow-hidden">
          {s.illustration === 'repair' ? (
            <div class="grid h-56 grid-cols-2 grid-rows-2 gap-1 p-1 md:h-full">
              <Image
                src={workbench}
                alt="Techniker öffnet ein Smartphone mit einem Präzisionsschraubendreher auf einer ESD-Unterlage"
                widths={[360, 640]}
                sizes="(min-width: 768px) 30vw, 100vw"
                class="col-span-2 h-full w-full rounded-xl object-cover"
                loading="lazy"
              />
              <Image
                src={display}
                alt="Neues Display-Glas wird für den Einbau auf ein Smartphone aufgelegt"
                widths={[240, 420]}
                sizes="(min-width: 768px) 15vw, 50vw"
                class="h-full w-full rounded-xl object-cover"
                loading="lazy"
              />
              <Image
                src={microscope}
                alt="Platine eines Smartphones unter dem Mikroskop bei der Fehlersuche"
                widths={[240, 420]}
                sizes="(min-width: 768px) 15vw, 50vw"
                class="h-full w-full rounded-xl object-cover"
                loading="lazy"
              />
            </div>
          ) : (
            <Image
              src={photos[s.illustration as keyof typeof photos]}
              alt=""
              widths={[420, 760]}
              sizes="(min-width: 768px) 30vw, 100vw"
              class="h-56 w-full object-cover md:h-full"
              loading="lazy"
            />
          )}
        </figure>
        <div class="p-8 md:p-12">
          <h2 id={`${s.slug}-title`} class="text-3xl font-bold">{s.title}</h2>
          <p class="prose-measure mt-3 text-ink-700">{s.summary}</p>
          <ul class="mt-5 space-y-2">
            {s.bullets.map((b) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent-600"></span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <a href={`tel:${shop.phone}`} class="btn-primary mt-8">Jetzt anrufen</a>
        </div>
      </GlassPanel>
    </section>
  ))}

  <section class="mx-auto max-w-6xl px-4 py-12">
    <p class="prose-measure text-ink-700">Preise nennen wir Ihnen nach einer kurzen Diagnose vor Ort oder am Telefon – ehrlich und ohne Überraschungen.</p>
  </section>
</BaseLayout>
