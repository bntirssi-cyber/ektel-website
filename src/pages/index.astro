---
import BaseLayout from '../layouts/BaseLayout.astro';
import VantaHero from '../components/VantaHero.astro';
import GlassPanel from '../components/GlassPanel.astro';
import OpenBadge from '../components/OpenBadge.astro';
import { shop } from '../data/shop';

const title = 'EKTEL Mobilfunk & Smartphones – Reparatur, Verkauf, Ankauf im Bahnhof Altona';
const description = `Smartphone-Reparatur, Verkauf, Ankauf und SIM-Karten direkt im Bahnhof Hamburg-Altona. ${shop.reviewCountLabel}. ${shop.hoursShort}.`;
---
<BaseLayout title={title} description={description}>
  <VantaHero class="-mt-16 pt-16">
    <div class="mx-auto grid max-w-6xl items-end gap-6 px-4 pb-12 pt-28 md:grid-cols-12 md:pb-0 md:pt-36">
      <GlassPanel as="div" variant="frosted" class="p-7 md:col-span-7 md:col-start-1 md:p-12">
        <OpenBadge class="mb-6" />
        <h1 id="hero-title" class="text-4xl font-bold md:text-6xl">Handy kaputt? Wir helfen – alles an einem Ort.</h1>
        <p class="prose-measure mt-5 text-lg text-ink-700">
          Reparatur, Smartphones, Zubehör, Ankauf und SIM-Karten – im Bahnhof Altona, sieben Tage die Woche. Erst schauen wir uns Ihr Gerät an, dann nennen wir den Preis.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`tel:${shop.phone}`} class="btn-primary">Jetzt anrufen</a>
          <a href={shop.mapsUrl} class="btn-ghost" rel="noopener" target="_blank">Route planen</a>
        </div>
      </GlassPanel>
      <GlassPanel as="div" variant="balanced" class="p-6 md:col-span-4 md:col-start-9 md:mb-[-2.5rem] md:translate-y-10">
        <p class="font-display text-3xl font-bold leading-tight">{shop.reviewCountLabel}</p>
        <p class="mt-3 text-ink-700">{shop.locationHint}</p>
      </GlassPanel>
    </div>
  </VantaHero>
</BaseLayout>
