---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollPhoneHero from '../components/ScrollPhoneHero.astro';
import CloudSky from '../components/CloudSky.astro';
import GlassPanel from '../components/GlassPanel.astro';
import ServiceTile from '../components/ServiceTile.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { shop } from '../data/shop';

const title = 'EKTEL Mobilfunk & Smartphones – Reparatur, Verkauf, Ankauf im Bahnhof Altona';
const description = `Smartphone-Reparatur, Verkauf, Ankauf und SIM-Karten direkt im Bahnhof Hamburg-Altona. ${shop.reviewCountLabel}. ${shop.hoursShort}.`;
---
<BaseLayout title={title} description={description}>
  <ScrollPhoneHero />

  <CloudSky>
    <section aria-labelledby="services-title" class="mx-auto max-w-6xl px-4 pb-16 pt-20">
      <h2 id="services-title" class="text-3xl font-bold md:text-4xl">Was wir für Sie tun</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-12">
        <ServiceTile service={shop.services[0]} size="lg" />
        <ServiceTile service={shop.services[1]} />
        <ServiceTile service={shop.services[2]} />
        <ServiceTile service={shop.services[3]} size="lg" />
      </div>
    </section>

    <section aria-labelledby="proof-title" class="mx-auto max-w-6xl px-4 pb-16">
      <GlassPanel as="div" variant="balanced" class="p-6 md:ml-auto md:max-w-md md:p-8">
        <h2 id="proof-title" class="sr-only">Bewertungen</h2>
        <p class="font-display text-3xl font-bold leading-tight">{shop.reviewCountLabel}</p>
        <p class="mt-3 text-ink-700">{shop.locationHint}</p>
      </GlassPanel>
    </section>
  </CloudSky>

  <div class="sky-static">
    <TrustStrip />

    <section aria-labelledby="route-title" class="mx-auto max-w-6xl px-4 pb-8">
      <GlassPanel as="div" variant="frosted" class="grid gap-6 p-8 md:grid-cols-2 md:p-12">
        <div>
          <h2 id="route-title" class="text-3xl font-bold">So finden Sie uns</h2>
          <p class="mt-3 text-ink-700">{shop.street}, {shop.zip} {shop.city}<br />{shop.locationHint}</p>
        </div>
        <div class="flex flex-wrap items-start gap-3 md:justify-end">
          <a href={`tel:${shop.phone}`} class="btn-primary">{shop.phoneDisplay} anrufen</a>
          <a href="/kontakt" class="btn-ghost">Öffnungszeiten & Anfahrt</a>
        </div>
      </GlassPanel>
    </section>
  </div>
</BaseLayout>
